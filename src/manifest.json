{
  "manifest_version": 3,
  "name": "\u0905\u0930\u094d\u091c\u0941\u0928\u0903 (Arjunah)",
  "version": "1.0.0",
  "version_name": "1.0.0-alpha.7",
  "description": "Bring your own AI to websites through a user-controlled, origin-scoped window.ai.arjunah extension.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "\u0905\u0930\u094d\u091c\u0941\u0928\u0903 (Arjunah)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["renderer/core.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-api.js", "icons/providers/*"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
