{
  "name": "arjunah",
  "version": "1.0.0-alpha.7",
  "description": "TypeScript SDK and types for अर्जुनः (Arjunah): let your website use the AI your visitor already has, through window.ai.arjunah.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mesudip/arjunah.git",
    "directory": "packages/sdk"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "keywords": [
    "ai",
    "browser-extension",
    "window.ai",
    "arjunah",
    "bring-your-own-ai",
    "sdk",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  }
}
