{
  "name": "arjunah-widget",
  "version": "1.0.0-alpha.5",
  "description": "The अर्जुनः (Arjunah) chat renderer, mounted against your own backend — the same widget the browser extension hosts, without the extension.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mesudip/arjunah.git",
    "directory": "packages/widget"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node ../../scripts/build-widget.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "ai",
    "chat",
    "widget",
    "assistant",
    "arjunah"
  ],
  "engines": {
    "node": ">=22.22.0"
  }
}
